---
import Monogram from '../assets/monogram.svg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="WeTheGods — metalcore band from the Czech Republic." />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>WeTheGods</title>
    <style>
      html {
        background: #0b0b0c;
        color: #f2f0ea;
        font-family: system-ui, sans-serif;
      }
      main {
        display: grid;
        place-items: center;
        gap: 2rem;
        min-height: 100svh;
        align-content: center;
      }
      svg {
        width: clamp(6rem, 18vw, 10rem);
        height: auto;
      }
      p {
        margin: 0;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        font-size: 0.75rem;
        opacity: 0.7;
      }
    </style>
  </head>
  <body>
    <main>
      <Monogram role="img" aria-label="WeTheGods" />
      <p>Signal incoming</p>
    </main>
  </body>
</html>
