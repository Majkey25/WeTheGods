---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Shows from '../components/Shows.astro';
import Music from '../components/Music.astro';
import Videos from '../components/Videos.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import type { Lang } from '../i18n';

// English lives at the root, Czech under /cs/.
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'cs' } }];
}

const lang: Lang = Astro.params.lang === 'cs' ? 'cs' : 'en';
---

<Base lang={lang}>
  <Hero lang={lang} />
  <Shows lang={lang} />
  <Music lang={lang} />
  <Videos lang={lang} />
  <About lang={lang} />
  <Gallery lang={lang} />
  <Contact lang={lang} />
</Base>
