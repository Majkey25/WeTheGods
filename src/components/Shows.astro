---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { cityLabel, dateParts, eventJsonLd, getEvents, getSettings, type Event } from '../content';
import { dict, pageUrl, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Short teaser for the home page. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = dict[lang];
const { upcoming, past } = await getEvents();
const settings = await getSettings();
// The home page teaser shows the next three dates only.
const shown = compact ? upcoming.slice(0, 3) : upcoming;
const detail = (e: Event) => `${pageUrl(lang, 'shows')}${e.slug}/`;
const site = Astro.site ?? new URL('https://majkey25.github.io');
const ld = upcoming.map((e) => eventJsonLd(e, new URL(detail(e), site).href));
---

<section id="shows" class="section" aria-labelledby="shows-title">
  <div class="wrap">
    <SectionHead
      id="shows-title"
      title={t.shows.heading}
      as={compact ? 'h2' : 'h1'}
      more={compact ? { href: pageUrl(lang, 'shows'), label: t.more.shows } : undefined}
    />

    {shown.length > 0 ? (
      <ul class="shows" data-reveal>
        {shown.map((e) => {
          const d = dateParts(t.locale, e.date);
          const place = [e.title && e.venue, cityLabel(t.locale, e)].filter(Boolean).join(' · ');
          return (
            <li class:list={['show', { 'show--inactive': e.inactive }]}>
              <time class="show__date" datetime={e.time ? `${e.date}T${e.time}` : e.date}>
                <span class="show__day">{d.day}</span>
                <span class="label">
                  {d.rest}
                  {e.time && ` · ${e.time}`}
                </span>
              </time>
              <div class="show__where">
                {e.type !== 'show' && <p class="show__type label">{t.shows.types[e.type]}</p>}
                <a class="show__link" href={detail(e)}>
                  <span class="show__venue fx">{e.name}</span>
                </a>
                {place && <p class="label">{place}</p>}
                {e.lineup && (
                  <p class="show__lineup">
                    {t.shows.with} {e.lineup.join(', ')}
                  </p>
                )}
              </div>
              <div class="show__action">
                {e.status && <span class="show__status label">[{t.shows.status[e.status]}]</span>}
                {e.tickets && (!e.status || e.status === 'free') && (
                  <a class="btn out show__tickets" href={e.tickets} rel="noopener" target="_blank">
                    {t.shows.link[e.type]}
                  </a>
                )}
                <span class="show__more label" aria-hidden="true">
                  {t.shows.details}
                  <Icon name="arrow-right" />
                </span>
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="empty" data-reveal>
        <p class="empty__title">{t.shows.emptyTitle}</p>
        <p class="empty__text">{t.shows.emptyText}</p>
        <div class="empty__cta">
          <a class="btn" href={pageUrl(lang, 'contact')}>
            {t.shows.book}
          </a>
          <a class="btn btn--red out" href={settings.instagram} rel="noopener" target="_blank">
            {t.shows.follow}
          </a>
        </div>
      </div>
    )}

    {!compact && past.length > 0 && (
      <details class="past" data-reveal open>
        <summary class="past__summary">
          <span class="label">{t.shows.past}</span>
          <span class="label">({past.length})</span>
        </summary>
        <ul class="past__list">
          {past.map((e) => (
            <li>
              <a class="past__row" href={detail(e)}>
                <time class="label" datetime={e.date}>
                  {dateParts(t.locale, e.date).short}
                </time>
                <span class="past__venue fx">
                  {e.name}
                  {e.type !== 'show' && <span class="label"> · {t.shows.types[e.type]}</span>}
                </span>
                <span class="past__city">{cityLabel(t.locale, e)}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
  {ld.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  )}
</section>

<style>
  .shows {
    border-top: 1px solid var(--line);
  }

  .show {
    position: relative;
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr auto;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.25s;
  }

  .show:hover {
    background: var(--panel);
  }

  /* The whole row opens the detail page; the tickets button stays clickable on top. */
  .show__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .show__tickets {
    position: relative;
    z-index: 1;
  }

  .show--inactive .show__day,
  .show--inactive .show__venue {
    text-decoration: line-through;
    opacity: 0.55;
  }

  .show__date {
    display: grid;
    gap: 0.35rem;
  }

  .show__day {
    font: 500 clamp(3rem, 6vw, 4.5rem) / 0.85 var(--font-display);
  }

  .show__where {
    display: grid;
    gap: 0.4rem;
  }

  .show__type {
    color: var(--ch-a);
  }

  .show__venue {
    font: 600 clamp(1.4rem, 2.5vw, 2rem) / 1.05 var(--font-display);
  }

  .show__lineup {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .show__action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem 1.5rem;
  }

  .show__status {
    color: var(--fg);
  }

  .show__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
  }

  .show__more :global(.icon) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.25s var(--ease);
  }

  .show:hover .show__more :global(.icon) {
    transform: translateX(4px);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px dashed var(--line);
  }

  .empty__title {
    font: 500 clamp(1.7rem, 3.5vw, 2.8rem) / 1.05 var(--font-display);
  }

  .empty__text {
    max-width: 44ch;
    color: var(--muted);
  }

  .empty__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .past {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .past__summary {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
  }

  .past__summary::-webkit-details-marker {
    display: none;
  }

  .past__summary::after {
    content: '+';
    margin-left: auto;
    font: 400 1.5rem/1 var(--font-mono);
    transition: transform 0.3s var(--ease);
  }

  .past[open] .past__summary::after {
    transform: rotate(45deg);
  }

  .past__summary:hover .label:first-child {
    color: var(--fg);
  }

  .past__row {
    display: grid;
    grid-template-columns: 8.5rem 1fr auto;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
    transition: background-color 0.25s;
  }

  .past__row:hover {
    background: var(--panel);
  }

  .past__venue {
    font: 600 1.2rem/1.2 var(--font-display);
  }

  .past__city {
    color: var(--muted);
    font-size: 0.95rem;
    text-align: right;
  }

  @media (width <= 44rem) {
    .show {
      grid-template-columns: 1fr;
    }

    .show__date {
      grid-auto-flow: column;
      justify-content: start;
      align-items: end;
      gap: 0.9rem;
    }

    .show__action {
      justify-content: flex-start;
    }

    .past__row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .past__city {
      text-align: left;
    }
  }
</style>
