---
import { Picture } from 'astro:assets';
import { links, videos } from '../data/site';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = dict[Astro.props.lang];
---

<section id="videos" class="section" aria-labelledby="videos-title">
  <div class="wrap">
    <header class="section__head">
      <h2 id="videos-title" class="h2">
        <span class="glitch" data-text={t.videos.heading}>
          {t.videos.heading}
        </span>
      </h2>
      <p class="label channel" aria-hidden="true">
        CH 03
      </p>
    </header>

    <ul class="videos" data-reveal>
      {videos.map((v, i) => (
        <li class:list={['video', { 'video--feature': i === 0 }]}>
          <a
            class="yt fx-img"
            href={`https://www.youtube.com/watch?v=${v.id}`}
            data-yt={v.id}
            data-title={v.title}
            rel="noopener"
            target="_blank"
            aria-label={`${t.videos.play}: ${v.title}`}
          >
            <Picture
              src={v.thumb}
              formats={['avif']}
              fallbackFormat="webp"
              widths={i === 0 ? [640, 960, 1280, 1920] : [480, 640, 960]}
              sizes={i === 0 ? '(width > 56rem) 90vw, 100vw' : '(width > 56rem) 45vw, 100vw'}
              alt=""
            />
            <span class="yt__play" aria-hidden="true" />
          </a>
          <p class="video__caption">
            <span class="video__title fx">{v.title}</span>
            <span class="label">{v.year}</span>
          </p>
        </li>
      ))}
    </ul>

    <a class="btn out videos__more" href={links.youtube} rel="noopener" target="_blank">
      {t.videos.more}
    </a>
  </div>
</section>

<script>
  // Swap the thumbnail for the real player only when asked: no YouTube request until then.
  document.querySelectorAll<HTMLAnchorElement>('.yt').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.yt}?autoplay=1&rel=0`;
      frame.title = link.dataset.title ?? 'YouTube video';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.className = 'yt__frame';
      link.replaceWith(frame);
      frame.focus();
    });
  });
</script>

<style>
  .videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 2rem);
  }

  .video--feature {
    grid-column: 1 / -1;
  }

  .yt,
  .video :global(.yt__frame) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 0;
    background: var(--panel);
  }

  .yt :global(picture),
  .yt :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s var(--ease),
      opacity 0.3s;
  }

  .yt__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(3.5rem, 7vw, 5.5rem);
    aspect-ratio: 1;
    border: 1px solid #fff;
    border-radius: 50%;
    background: rgb(10 10 11 / 0.35);
    translate: -50% -50%;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      scale 0.3s var(--ease);
  }

  .yt__play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    border-block: 0.6em solid transparent;
    border-left: 1em solid #fff;
    translate: 12% 0;
  }

  .yt:hover .yt__play {
    border-color: #fff;
    background: #fff;
    scale: 1.08;
  }

  .yt:hover .yt__play::after {
    border-left-color: #0a0a0b;
  }

  .video__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .video__title {
    font: 400 clamp(1.5rem, 2.5vw, 2rem) / 1.1 var(--font-display);
  }

  .videos__more {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (width <= 40rem) {
    .videos {
      grid-template-columns: 1fr;
    }
  }
</style>
