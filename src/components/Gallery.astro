---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { gallery } from '../data/site';
import SectionHead from './SectionHead.astro';
import { dict, pageUrl, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Short teaser for the home page. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = dict[lang];

// The home page teaser shows five photos that link to the gallery page; no lightbox there.
const photos = compact ? gallery.slice(0, 5) : gallery;

// Full-size sources for the lightbox, only fetched when a photo is opened.
const items = await Promise.all(
  photos.map(async (p) => {
    if (compact) {
      return {
        ...p,
        href: pageUrl(lang, 'gallery'),
        label: `${t.more.gallery}: ${p.alt[lang]}`,
        data: {},
      };
    }
    const widths = [1280, 1920, 2560];
    const [avif, webp] = await Promise.all(
      (['avif', 'webp'] as const).map((format) =>
        getImage({ src: p.src, format, widths, quality: 80 }),
      ),
    );
    const caption = p.credit ? `${p.alt[lang]} — ${t.gallery.photo}: ${p.credit}` : p.alt[lang];
    return {
      ...p,
      href: webp.src,
      label: `${t.gallery.open}: ${p.alt[lang]}`,
      data: {
        'data-avif': avif.srcSet.attribute,
        'data-webp': webp.srcSet.attribute,
        'data-alt': p.alt[lang],
        'data-caption': caption,
      },
    };
  }),
);

const sizes = (i: number) =>
  i % 5 === 0
    ? '(width > 48rem) 66vw, 100vw'
    : i % 5 < 3
      ? '(width > 48rem) 33vw, 50vw'
      : '(width > 48rem) 50vw, 50vw';
---

<section id="gallery" class="section" aria-labelledby="gallery-title">
  <div class="wrap">
    <SectionHead
      id="gallery-title"
      title={t.gallery.heading}
      channel="CH 05"
      as={compact ? 'h2' : 'h1'}
      more={compact ? { href: pageUrl(lang, 'gallery'), label: t.more.gallery } : undefined}
    />

    <ul class="gallery" data-reveal>
      {items.map((p, i) => (
        <li>
          <a class="gallery__item fx-img" href={p.href} {...p.data} aria-label={p.label}>
            <Picture
              src={p.src}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[480, 800, 1200, 1600]}
              sizes={sizes(i)}
              quality={72}
              alt={p.alt[lang]}
            />
          </a>
        </li>
      ))}
    </ul>
  </div>

  {!compact && (
    <dialog class="lightbox" aria-label={t.gallery.heading}>
      <figure class="lightbox__figure">
        <picture>
          <source type="image/avif" sizes="100vw" />
          <img class="lightbox__img" alt="" sizes="100vw" decoding="async" />
        </picture>
        <figcaption class="lightbox__caption label"></figcaption>
      </figure>
      <p class="lightbox__count label" aria-live="polite"></p>
      <button class="lightbox__btn lightbox__close label" type="button">
        {t.gallery.close}
        <Icon name="close" />
      </button>
      <button class="lightbox__btn lightbox__prev" type="button" aria-label={t.gallery.prev}>
        <Icon name="arrow-left" />
      </button>
      <button class="lightbox__btn lightbox__next" type="button" aria-label={t.gallery.next}>
        <Icon name="arrow-right" />
      </button>
    </dialog>
  )}
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.gallery__item')];
  const source = dialog?.querySelector('source');
  const img = dialog?.querySelector<HTMLImageElement>('.lightbox__img');
  const caption = dialog?.querySelector('.lightbox__caption');
  const count = dialog?.querySelector('.lightbox__count');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (dialog && source && img && caption && count && links.length) {
    let index = 0;
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const data = links[index]?.dataset ?? {};
      source.srcset = data.avif ?? '';
      img.srcset = data.webp ?? '';
      img.alt = data.alt ?? '';
      caption.textContent = data.caption ?? '';
      count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(links.length).padStart(2, '0')}`;
      if (!reduced.matches) {
        img.animate(
          [
            { transform: 'translateX(-10px)', opacity: 0.4 },
            { transform: 'translateX(6px)', opacity: 1 },
            { transform: 'none' },
          ],
          { duration: 240, easing: 'steps(3)' },
        );
      }
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('.lightbox__prev')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lightbox__next')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
    // Click on the backdrop (outside the photo) closes.
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    let startX = 0;
    dialog.addEventListener('pointerdown', (e) => (startX = e.clientX));
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (e.pointerType !== 'mouse' && Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 1vw, 1rem);
  }

  .gallery li {
    grid-column: span 4;
    aspect-ratio: 3 / 2;
  }

  .gallery li:nth-child(5n + 1) {
    grid-column: span 8;
    grid-row: span 2;
    aspect-ratio: auto;
  }

  .gallery li:nth-child(10n + 6) {
    grid-column: 5 / span 8;
  }

  .gallery li:nth-child(5n + 4),
  .gallery li:nth-child(5n + 5) {
    grid-column: span 6;
  }

  .gallery__item {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--panel);
  }

  .gallery__item :global(picture),
  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
  }

  .gallery__item :global(img) {
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(3.5rem, 7vw, 5rem) clamp(1rem, 5vw, 5rem);
    border: 0;
    color: #eeece6;
    background: rgb(6 6 7 / 0.96);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox__figure {
    display: grid;
    gap: 1rem;
    justify-items: center;
    max-height: 100%;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 11rem);
    width: auto;
    object-fit: contain;
    touch-action: pan-y;
  }

  .lightbox__caption {
    max-width: 70ch;
    color: #b9b6ad;
    text-align: center;
  }

  .lightbox__count {
    position: absolute;
    top: 1.5rem;
    left: clamp(1rem, 5vw, 5rem);
    color: #eeece6;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 3rem;
    min-height: 3rem;
    color: #eeece6;
  }

  .lightbox__close {
    top: 0.75rem;
    right: clamp(0.5rem, 4vw, 4rem);
    padding-inline: 0.75rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
    font-size: 1.75rem;
  }

  .lightbox__prev {
    left: clamp(0rem, 1vw, 1.5rem);
  }

  .lightbox__next {
    right: clamp(0rem, 1vw, 1.5rem);
  }

  .lightbox__btn :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .lightbox__close {
    gap: 0.5rem;
    grid-auto-flow: column;
  }

  .lightbox__close :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (width <= 48rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery li,
    .gallery li:nth-child(5n + 4),
    .gallery li:nth-child(5n + 5),
    .gallery li:nth-child(10n + 6) {
      grid-column: span 1;
    }

    .gallery li:nth-child(5n + 1) {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 3 / 2;
    }

    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 0.75rem;
      translate: none;
    }
  }
</style>
