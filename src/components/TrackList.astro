---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { dict, type Lang } from '../i18n';

interface Props {
  songs: CollectionEntry<'songs'>['data'][];
  link: string;
  lang: Lang;
  showDescriptions?: boolean;
}

const { songs, link, lang, showDescriptions = true } = Astro.props;
const t = dict[lang];
---

<ol class="tracks" aria-label={t.music.tracklist}>
  {songs.map((song, i) => (
    <li>
      <a
        href={link}
        data-music-open={song.slug}
        aria-haspopup="dialog"
        aria-controls="music-details"
        aria-label={`${t.music.songDetails}: ${song.title}`}
        target="_blank"
        rel="noopener"
      >
        <span class="label tracks__number" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="tracks__body">
          <strong>{song.title}</strong>
          {showDescriptions && (
            <span class="tracks__description">{song[`description_${lang}`]}</span>
          )}
        </span>
        <Icon name="arrow-right" />
      </a>
    </li>
  ))}
</ol>

<style>
  .tracks {
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .tracks li {
    border-bottom: 1px solid var(--line);
  }

  .tracks a {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) 1.1rem;
    gap: 1rem;
    align-items: start;
    min-height: 3rem;
    padding-block: 0.85rem;
  }

  .tracks__number {
    padding-top: 0.25rem;
  }

  .tracks__body {
    display: grid;
    gap: 0.35rem;
  }

  .tracks strong {
    font: 600 1.2rem/1.25 var(--font-display);
  }

  .tracks__description {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .tracks :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    transition: transform 0.2s var(--ease);
  }

  .tracks a:hover strong {
    color: var(--ch-a-text);
  }

  .tracks a:hover :global(.icon) {
    transform: translateX(3px);
  }
</style>
