---
import { Picture } from 'astro:assets';
import { getMusicCatalog } from '../content';
import SectionHead from './SectionHead.astro';
import MusicDetails from './MusicDetails.astro';
import TrackList from './TrackList.astro';
import Icon from './Icon.astro';
import { dict, pageUrl, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Short teaser for the home page. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = dict[lang];
const releases = await getMusicCatalog();
const [ep, ...singles] = releases;
const featuredDescription = ep?.song?.[`description_${lang}`] ?? ep?.[`description_${lang}`];
const ReleaseHeading = compact ? 'h3' : 'h2';
const fullDate = (iso: string) =>
  new Intl.DateTimeFormat(t.locale, { dateStyle: 'long', timeZone: 'UTC' }).format(
    new Date(`${iso}T12:00:00Z`),
  );
---

<section id="music" class="section" aria-labelledby="music-title">
  <div class="wrap">
    <SectionHead
      id="music-title"
      title={t.music.heading}
      as={compact ? 'h2' : 'h1'}
      more={compact ? { href: pageUrl(lang, 'music'), label: t.more.music } : undefined}
    />

    {ep && (
      <article class="feature" data-reveal={compact || undefined}>
        <a
          class="feature__cover fx-img"
          href={ep.link}
          data-music-open={ep.detailId}
          aria-haspopup="dialog"
          aria-controls="music-details"
          aria-label={`${t.music.details}: ${ep.title}`}
          rel="noopener"
          target="_blank"
        >
          <Picture
            src={ep.cover}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 700, 1000]}
            sizes="(width > 56rem) calc((min(100vw - clamp(2.5rem, 8vw, 6rem), 90rem) - clamp(2rem, 5vw, 5rem)) / 2), calc(100vw - clamp(2.5rem, 8vw, 6rem))"
            alt={`${t.music.cover}: ${ep.title} — WeTheGods`}
            loading={compact ? 'lazy' : 'eager'}
            fetchpriority={compact ? 'auto' : 'high'}
          />
        </a>
        <div class="feature__body">
          <p class="label">
            {t.music.kinds[ep.type]} · <time datetime={ep.date}>{fullDate(ep.date)}</time>
          </p>
          <ReleaseHeading class="feature__title fx">{ep.title}</ReleaseHeading>
          {featuredDescription && <p class="feature__description">{featuredDescription}</p>}
          {ep.songs.length > 0 && <TrackList songs={ep.songs} link={ep.link} lang={lang} />}
          <div class="feature__cta">
            <a
              class="btn"
              href={ep.link}
              data-music-open={ep.detailId}
              aria-haspopup="dialog"
              aria-controls="music-details"
              rel="noopener"
              target="_blank"
            >
              {t.music.details}
              <Icon name="arrow-right" />
            </a>
            {ep.platforms && (
              <ul class="platforms">
                {ep.platforms.map((p) => (
                  <li>
                    <a class="label ulink out" href={p.url} rel="noopener" target="_blank">
                      {p.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </article>
    )}

    {!compact && singles.length > 0 && (
      <>
        <h2 class="label singles__title">{t.music.singles}</h2>
        <ul class="singles" data-reveal>
          {singles.map((r) => (
            <li>
              <a
                class="single fx-img"
                href={r.link}
                data-music-open={r.detailId}
                aria-haspopup="dialog"
                aria-controls="music-details"
                rel="noopener"
                target="_blank"
              >
                <span class="single__cover">
                  <Picture
                    src={r.cover}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[300, 500, 700]}
                    sizes={
                      r.cover.width === r.cover.height
                        ? '(width > 56rem) 22vw, (width > 30rem) 45vw, 50vw'
                        : '(width > 56rem) 22vw, (width > 30rem) 45vw, 90vw'
                    }
                    alt=""
                  />
                </span>
                <span class="single__title fx">{r.title}</span>
                <span class="label">
                  {t.music.kinds[r.type]} · {r.date.slice(0, 4)}
                </span>
                {(r.song?.[`description_${lang}`] ?? r[`description_${lang}`]) && (
                  <span class="single__description">
                    {r.song?.[`description_${lang}`] ?? r[`description_${lang}`]}
                  </span>
                )}
                <span class="single__more label">
                  {r.song ? t.music.songDetails : t.music.details}
                  <Icon name="arrow-right" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
  <MusicDetails lang={lang} releases={releases} />
</section>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .feature__cover {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .feature__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .feature__body {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .feature__title {
    font: 500 clamp(4.25rem, 11vw, 9rem) / 0.9 var(--font-display);
    letter-spacing: -0.02em;
  }

  .feature__description {
    max-width: 45ch;
    color: var(--muted);
  }

  .feature__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .platforms a {
    color: var(--fg);
  }

  .singles__title {
    margin: clamp(4rem, 9vw, 6.5rem) 0 1.5rem;
  }

  .singles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  .single {
    display: grid;
    gap: 0.6rem;
  }

  .single__cover {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--panel);
  }

  .single__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.6s var(--ease),
      filter 0.3s;
  }

  .single__title {
    font: 600 1.3rem/1.15 var(--font-display);
  }

  .single__description {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .single__more {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--fg);
    margin-top: 0.25rem;
  }

  .single__more :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  @media (width <= 56rem) {
    .feature {
      grid-template-columns: 1fr;
    }

    .singles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
