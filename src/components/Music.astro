---
import { Picture } from 'astro:assets';
import { releases } from '../data/site';
import SectionHead from './SectionHead.astro';
import { dict, pageUrl, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Short teaser for the home page. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = dict[lang];
const [ep, ...singles] = releases;
const fullDate = (iso: string) =>
  new Intl.DateTimeFormat(t.locale, { dateStyle: 'long', timeZone: 'UTC' }).format(
    new Date(`${iso}T12:00:00Z`),
  );
---

<section id="music" class="section" aria-labelledby="music-title">
  <div class="wrap">
    <SectionHead
      id="music-title"
      title={t.music.heading}
      channel="CH 02"
      as={compact ? 'h2' : 'h1'}
      more={compact ? { href: pageUrl(lang, 'music'), label: t.more.music } : undefined}
    />

    {ep && (
      <article class="feature" data-reveal>
        <a
          class="feature__cover fx-img"
          href={ep.href}
          rel="noopener"
          target="_blank"
          tabindex="-1"
        >
          <Picture
            src={ep.cover}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[400, 700, 1000]}
            sizes="(width > 56rem) 45vw, 100vw"
            alt={`${ep.title} — cover`}
            loading={compact ? 'lazy' : 'eager'}
            fetchpriority={compact ? 'auto' : 'high'}
          />
        </a>
        <div class="feature__body">
          <p class="label">
            {t.music.ep} · <time datetime={ep.date}>{fullDate(ep.date)}</time>
          </p>
          <h3 class="feature__title fx">{ep.title}</h3>
          {ep.tracks && (
            <ol class="tracks" aria-label={t.music.tracklist}>
              {ep.tracks.map((track, i) => (
                <li>
                  <span class="label">{String(i + 1).padStart(2, '0')}</span>
                  {track}
                </li>
              ))}
            </ol>
          )}
          <div class="feature__cta">
            <a class="btn btn--solid out" href={ep.href} rel="noopener" target="_blank">
              {t.music.listen}
            </a>
            {ep.platforms && (
              <ul class="platforms">
                {ep.platforms.map((p) => (
                  <li>
                    <a class="label ulink out" href={p.href} rel="noopener" target="_blank">
                      {p.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </article>
    )}

    {!compact && (
      <>
        <h3 class="label singles__title">{t.music.singles}</h3>
        <ul class="singles" data-reveal>
          {singles.map((r) => (
            <li>
              <a class="single fx-img" href={r.href} rel="noopener" target="_blank">
                <span class="single__cover">
                  <Picture
                    src={r.cover}
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[300, 500, 700]}
                    sizes="(width > 56rem) 22vw, (width > 30rem) 45vw, 90vw"
                    alt=""
                  />
                </span>
                <span class="single__title fx">{r.title}</span>
                <span class="label">
                  {t.music.single} · {r.date.slice(0, 4)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .feature__cover {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .feature__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .feature__body {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .feature__title {
    font: 400 clamp(4.25rem, 11vw, 9rem) / 0.9 var(--font-display);
    letter-spacing: -0.02em;
  }

  .tracks {
    display: grid;
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .tracks li {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    font: 500 1.2rem/1.25 var(--font-display);
  }

  .feature__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .platforms a {
    color: var(--fg);
  }

  .singles__title {
    margin: clamp(4rem, 9vw, 6.5rem) 0 1.5rem;
  }

  .singles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
  }

  .single {
    display: grid;
    gap: 0.6rem;
  }

  .single__cover {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--panel);
  }

  .single__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.6s var(--ease),
      filter 0.3s;
  }

  .single__title {
    font: 500 1.3rem/1.15 var(--font-display);
  }

  @media (width <= 56rem) {
    .feature {
      grid-template-columns: 1fr;
    }

    .singles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
