---
import { getSettings } from '../content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import ContactLink from './ContactLink.astro';
import { dict, pageUrl, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Short teaser for the home page. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = dict[lang];
const form = t.contact.form;
const { email, web3forms_access_key, presskit, merch, socials } = await getSettings();
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="wrap">
    <SectionHead
      id="contact-title"
      title={t.contact.heading}
      as={compact ? 'h2' : 'h1'}
      more={compact ? { href: pageUrl(lang, 'contact'), label: t.more.contact } : undefined}
    />

    {!compact && (
      <div class="contact" data-reveal>
        {web3forms_access_key && (
          <form
            class="form"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-sending={form.sending}
            data-sent={form.sent}
            data-error={form.error}
          >
            <h2 class="form__title">{form.title}</h2>
            <div class="form__row">
              <label class="field">
                <span class="label">{form.name}</span>
                <input name="name" autocomplete="name" maxlength="100" />
              </label>
              <label class="field">
                <span class="label">{form.email}</span>
                <input type="email" name="email" autocomplete="email" required maxlength="200" />
              </label>
            </div>
            <label class="field">
              <span class="label">{form.topic}</span>
              <select name="topic">
                {Object.values(form.topics).map((label) => (
                  <option>{label}</option>
                ))}
              </select>
            </label>
            <label class="field">
              <span class="label">{form.message}</span>
              <textarea name="message" rows="6" required maxlength="5000"></textarea>
            </label>
            <input
              type="checkbox"
              name="botcheck"
              hidden
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <input type="hidden" name="access_key" value={web3forms_access_key} />
            <input type="hidden" name="subject" value="WeTheGods web" />
            <div class="form__foot">
              <button class="btn" type="submit">
                {form.send}
              </button>
              <p class="form__note">
                {form.privacy}{' '}
                <a class="ulink" href="#privacy">
                  {t.footer.privacy}
                </a>
              </p>
            </div>
            <p class="form__status" role="status" aria-live="polite"></p>
          </form>
        )}

        <div class="cols">
          {presskit && (
            <div>
              <h2 class="label">{t.contact.presskit}</h2>
              <a class="cols__link ulink out" href={presskit} rel="noopener" target="_blank">
                {t.contact.presskitLink}
                <Icon name="arrow-up-right" class="out__icon" />
              </a>
            </div>
          )}
          {merch && (
            <div>
              <h2 class="label">{t.contact.merch}</h2>
              <a class="cols__link ulink out" href={merch} rel="noopener" target="_blank">
                {t.contact.merchLink}
                <Icon name="arrow-up-right" class="out__icon" />
              </a>
            </div>
          )}
          <div class="cols__follow">
            <h2 class="label">{t.contact.follow}</h2>
            <ul class="socials">
              {socials.map((s) => (
                <li>
                  <a class="cols__link ulink out" href={s.url} rel="noopener" target="_blank">
                    {s.name}
                    <Icon name="arrow-up-right" class="out__icon" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    )}

    {/* The form is the main way in; the address stays for people who prefer their own mail app. */}
    <div class="mail" id="booking-email" data-reveal>
      <p class="label">{t.contact.booking}</p>
      <ContactLink class="mail__link ulink" value={email} lang={lang}>
        {lang === 'cs' ? 'Napsat e-mail' : 'Email us'}
      </ContactLink>
      <ContactLink class="mail__copy label" value={email} lang={lang} action="reveal">
        {lang === 'cs' ? 'Zobrazit e-mail' : 'Show email'}
      </ContactLink>
      <ContactLink class="mail__copy label" value={email} lang={lang} action="copy">
        {t.contact.copy}
      </ContactLink>
    </div>
    {!compact && (
      <section id="privacy" class="privacy" aria-labelledby="privacy-title">
        <h2 id="privacy-title">{t.footer.privacy}</h2>
        {lang === 'cs' ? (
          <>
            <p>
              Kontaktní formulář odešle e-mail, zprávu, téma a případné jméno službě Web3Forms pro
              přeposlání do schránky kapely. Web3Forms obdrží také technické údaje spojení a může
              předat IP adresu a e-mail antispamovým službám. Pro tento formulář jsme nastavili
              automatické mazání přijatých podání starších než sedm dní. Služba působí z Indie a
              její infrastruktura může data zpracovávat v dalších regionech. Místo formuláře můžete
              použít vlastní e-mailovou aplikaci.
            </p>
            <p>
              Dotazy k údajům ve zprávách, žádosti o přístup, opravu nebo výmaz posílejte na{' '}
              <a class="ulink" href="#booking-email">
                e-mail kapely
              </a>
              . Neposílejte citlivé údaje ani údaje jiných lidí, které nejsou pro dotaz potřebné.
            </p>
            <p>
              Web neobsahuje analytické ani reklamní skripty. Volbu motivu uchovává místně ve vašem
              prohlížeči do jejího smazání; údaj o přehrání úvodní animace zůstává jen po dobu
              relace. Tyto údaje lze odstranit vymazáním dat webu v prohlížeči.
            </p>
            <p>
              GitHub Pages při načtení webu obdrží IP adresu a další technické údaje požadavku.
              YouTube se připojí až po spuštění videa. Odkazy na sociální sítě, obchod a prodejce
              vstupenek vedou na samostatné služby s vlastními podmínkami a pravidly soukromí.
            </p>
          </>
        ) : (
          <>
            <p>
              The contact form sends your email, message, topic and optional name to Web3Forms for
              forwarding to the band inbox. Web3Forms also receives technical connection data and
              may share your IP address and email with spam filters. We configured this form to
              automatically delete submissions older than seven days. The service operates from
              India and its infrastructure may process data in other regions. You can use your own
              email application instead.
            </p>
            <p>
              For questions about data in your messages, including access, correction or deletion
              requests, contact{' '}
              <a class="ulink" href="#booking-email">
                the band's email
              </a>
              . Do not send sensitive information or other people's details that are unnecessary for
              your enquiry.
            </p>
            <p>
              This site has no analytics or advertising scripts. Your theme choice stays in your
              browser until cleared; the intro animation flag lasts for the browser session. You can
              remove these preferences by clearing this site's browser data.
            </p>
            <p>
              GitHub Pages receives your IP address and other technical request data when serving
              the site. YouTube connects only when you play a video. Social, store and ticket links
              open separate services with their own terms and privacy practices.
            </p>
          </>
        )}
        <p>
          <a class="ulink" href="https://web3forms.com/privacy">
            Web3Forms
          </a>
          {' · '}
          <a
            class="ulink"
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
          >
            GitHub
          </a>
          {' · '}
          <a class="ulink" href="https://policies.google.com/privacy">
            Google / YouTube
          </a>
        </p>
      </section>
    )}
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.form');
  const status = form?.querySelector('.form__status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (form && status && button) {
    const say = (text: string, ok: boolean) => {
      status.textContent = text;
      status.classList.toggle('is-error', !ok);
    };
    let submitting = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting || !form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form));
      if (data.botcheck) return say(form.dataset.error ?? '', false);
      data.subject = `WeTheGods web — ${data.topic}: ${data.name}`;
      const label = button.textContent;
      const controller = new AbortController();
      const deadline = setTimeout(() => controller.abort(), 60_000);
      submitting = true;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      button.textContent = form.dataset.sending ?? label;
      status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'omit',
          redirect: 'error',
          body: JSON.stringify(data),
          signal: controller.signal,
        });
        const body: unknown = await res.json();
        if (
          !res.ok ||
          !body ||
          typeof body !== 'object' ||
          !('success' in body) ||
          body.success !== true
        )
          throw new Error(`status ${res.status}`);
        form.reset();
        say(form.dataset.sent ?? '', true);
      } catch {
        say(form.dataset.error ?? '', false);
      } finally {
        clearTimeout(deadline);
        submitting = false;
        button.disabled = false;
        form.removeAttribute('aria-busy');
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .privacy {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    max-width: 75ch;
  }

  .privacy p {
    margin-top: 1rem;
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .mail > p {
    width: 100%;
  }

  .contact + .mail {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .mail :global(.mail__link) {
    font: 600 clamp(1.15rem, 2vw, 1.6rem) / 1.2 var(--font-display);
    overflow-wrap: anywhere;
  }

  .mail :global(.mail__copy) {
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--line);
    color: var(--fg);
    transition: border-color 0.2s;
  }

  .mail :global(.mail__copy:hover) {
    border-color: var(--fg);
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
  }

  .form {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .form__title {
    font: 500 clamp(1.8rem, 3.2vw, 2.6rem) / 1.1 var(--font-display);
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--fg);
    background: var(--panel);
    font: 400 1rem/1.5 var(--font-body);
    transition: border-color 0.2s;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--muted);
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--fg);
    outline-offset: 0;
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .form__foot .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .form__note {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .form__status:not(:empty) {
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--fg);
    background: var(--panel);
  }

  .form__status.is-error {
    border-left-color: var(--ch-a);
  }

  .cols {
    display: grid;
    gap: 2.25rem;
    align-content: start;
  }

  .cols h2 {
    margin-bottom: 0.9rem;
  }

  .cols__link {
    font: 600 clamp(1.25rem, 1.9vw, 1.6rem) / 1.35 var(--font-display);
  }

  .socials {
    display: grid;
    gap: 0.15rem;
  }

  @media (width <= 56rem) {
    .contact {
      grid-template-columns: 1fr;
    }

    .cols {
      grid-template-columns: 1fr 1fr;
    }

    .cols__follow {
      grid-column: 1 / -1;
    }
  }

  @media (width <= 30rem) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
