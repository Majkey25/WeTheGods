{
  "name": "wethegods",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Official website of WeTheGods, a Czech metalcore band.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/contact.test.ts && node scripts/check-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "dependencies": {
    "astro": "^7.4.1",
    "js-yaml": "^5.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
